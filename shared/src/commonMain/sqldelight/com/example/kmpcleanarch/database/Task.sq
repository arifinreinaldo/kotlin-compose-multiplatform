-- Task table schema
CREATE TABLE IF NOT EXISTS TaskEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- Queries
selectAll:
SELECT * FROM TaskEntity
ORDER BY createdAt DESC;

selectById:
SELECT * FROM TaskEntity
WHERE id = ?;

insert:
INSERT INTO TaskEntity(title, description, isCompleted, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE TaskEntity
SET title = ?, description = ?, isCompleted = ?, updatedAt = ?
WHERE id = ?;

deleteById:
DELETE FROM TaskEntity
WHERE id = ?;

deleteAll:
DELETE FROM TaskEntity;

lastInsertRowId:
SELECT last_insert_rowid();
